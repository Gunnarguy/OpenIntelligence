{
  "version": 1,
  "name": "plaud-purple-light-validation-deep-think",
  "defaults": {
    "quality_mode": "deep-think",
    "timeout_seconds": 600
  },
  "cases": [
    {
      "id": "plaud_solid_purple_light_meaning_deepthink",
      "category": "exact_value",
      "input_files": ["PlaudNoteUserManualSQLite.txt"],
      "query": "What does the solid purple light mean on the PLAUD NOTE?",
      "expected_behavior": "answer",
      "expected_answer_patterns": [
        "(?i)\\bpurple\\b.*\\bcharging\\b",
        "(?i)\\bcharging\\b.*\\bpurple\\b"
      ]
    },
    {
      "id": "plaud_flashing_purple_light_meaning_deepthink",
      "category": "exact_value",
      "input_files": ["PlaudNoteUserManualSQLite.txt"],
      "query": "What does the flashing purple light mean on the PLAUD NOTE?",
      "expected_behavior": "answer",
      "expected_answer_patterns": [
        "(?i)\\bflashing\\s+purple\\b.*\\bbattery\\s+is\\s+low\\b",
        "(?i)\\bbattery\\s+is\\s+low\\b"
      ]
    }
  ]
}

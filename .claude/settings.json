            "timeout": 20,
            "statusMessage": "Checkpointing project state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-handoff.sh",
            "timeout": 20,
            "statusMessage": "Checking handoff state"
          }
        ]
      }
    ]
  }

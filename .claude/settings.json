{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 20,
            "statusMessage": "Loading project state"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/codemap/hook.py\" brief 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.agents/codemap/hook.sh\" ] && \"$HOME/.agents/codemap/hook.sh\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-compact.sh",
            "timeout": 20,
            "statusMessage": "Checkpointing project state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-handoff.sh",
            "timeout": 20,
            "statusMessage": "Checking handoff state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "notion-(update-page|create-pages|update-data-source|duplicate-page|move-pages)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/notion-receipt.sh",
            "timeout": 10,
            "statusMessage": "Recording roadmap write"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/instructions-loaded.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

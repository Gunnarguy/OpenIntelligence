# Copy this file to .env, set your issuer ID, and drop the AuthKey_*.p8 file into fastlane/keys/.
APP_STORE_CONNECT_ISSUER=YOUR_ASC_ISSUER_ID
# Optional overrides if you do not want to use the default fastlane/keys/AuthKey_<KEY_ID>.p8 path.
# APP_STORE_CONNECT_KEY_ID=YOUR_ASC_KEY_ID
# APP_STORE_CONNECT_PRIVATE_KEY_PATH=fastlane/keys/AuthKey_YOUR_ASC_KEY_ID.p8

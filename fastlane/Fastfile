# Fastfile for OpenIntelligence
# More documentation: https://docs.fastlane.tools

default_platform(:ios)

platform :ios do

  desc "Build the app for App Store submission"
  lane :build do
    build_app(
      scheme: "OpenIntelligence",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "OpenIntelligence.ipa",
      export_options: {
        signingStyle: "automatic",
        teamID: "Z3E334EXZD"  # Your Apple Developer Team ID
      }
    )
  end

  desc "Submit to App Store Connect for review"
  lane :release do
    # Build the app
    build

    # Upload to App Store Connect
    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,  # Set to false when you have screenshots
      submit_for_review: false,  # Set to true to auto-submit
      automatic_release: false,
      force: true  # Skip HTML preview
    )
  end

  desc "Upload to TestFlight for beta testing"
  lane :beta do
    build_app(
      scheme: "OpenIntelligence",
      export_method: "app-store"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Increment build number"
  lane :bump do
    increment_build_number(xcodeproj: "OpenIntelligence.xcodeproj")
  end

  desc "Upload metadata only (no binary) - for fixing App Store rejection"
  lane :metadata do
    # Read .p8 key content directly
    key_path = File.expand_path("~/AuthKey_JT97AQ3U4U.p8")
    key_content = File.read(key_path)

    # Clear any env var that would conflict with explicit api_key
    ENV.delete("APP_STORE_CONNECT_API_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: "JT97AQ3U4U",
      issuer_id: "843e4ca0-4a91-49c5-93d1-c4e336d7c43b",
      key_content: key_content,
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "Gunndamental.OpenIntelligence",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Validate app metadata and screenshots"
  lane :validate do
    deliver(
      verify_only: true,
      skip_screenshots: true,
      skip_binary_upload: true
    )
  end

  desc "Verify StoreKit products match subscription config"
  lane :verify_iap do
    require 'json'

    # Load subscription config
    subscriptions_path = File.join(Dir.pwd, "subscriptions.json")
    unless File.exist?(subscriptions_path)
      UI.user_error!("subscriptions.json not found in fastlane directory")
    end

    config = JSON.parse(File.read(subscriptions_path))

    # Expected products from config
    expected_products = []

    config["subscriptions"]&.each do |sub|
      expected_products << sub["product_id"]
    end

    config["non_consumables"]&.each do |nc|
      expected_products << nc["product_id"]
    end

    config["consumables"]&.each do |c|
      expected_products << c["product_id"]
    end

    # Load StoreKit config
    storekit_path = File.join(Dir.pwd, "..", "OpenIntelligence", "StoreKit", "StoreKitConfiguration.storekit")
    unless File.exist?(storekit_path)
      UI.user_error!("StoreKitConfiguration.storekit not found")
    end

    storekit = JSON.parse(File.read(storekit_path))
    storekit_products = storekit["products"].map { |p| p["id"] }

    # Compare
    missing_in_storekit = expected_products - storekit_products
    extra_in_storekit = storekit_products - expected_products

    if missing_in_storekit.any?
      UI.error("Products in subscriptions.json but NOT in StoreKitConfiguration.storekit:")
      missing_in_storekit.each { |p| UI.error("  - #{p}") }
    end

    if extra_in_storekit.any?
      UI.important("Products in StoreKitConfiguration.storekit but NOT in subscriptions.json:")
      extra_in_storekit.each { |p| UI.important("  - #{p}") }
    end

    if missing_in_storekit.empty? && extra_in_storekit.empty?
      UI.success("✅ All #{expected_products.count} products match between subscriptions.json and StoreKitConfiguration.storekit")

      # Print summary
      UI.message("")
      UI.message("📦 Product Summary:")
      config["subscriptions"]&.each do |sub|
        UI.message("  [SUB] #{sub['product_id']}: $#{sub['pricing']['USD']}/#{sub['duration']}")
      end
      config["non_consumables"]&.each do |nc|
        UI.message("  [IAP] #{nc['product_id']}: $#{nc['pricing']['USD']} (one-time)")
      end
      config["consumables"]&.each do |c|
        UI.message("  [CON] #{c['product_id']}: $#{c['pricing']['USD']} (consumable)")
      end
    else
      UI.user_error!("Product mismatch detected!")
    end
  end

  desc "Print App Store Connect setup checklist for subscriptions"
  lane :iap_checklist do
    require 'json'

    subscriptions_path = File.join(Dir.pwd, "subscriptions.json")
    config = JSON.parse(File.read(subscriptions_path))

    UI.header("App Store Connect In-App Purchase Setup Checklist")
    UI.message("")

    config["app_store_connect_setup_checklist"]&.each do |step|
      UI.message("  #{step}")
    end

    UI.message("")
    UI.success("See fastlane/subscriptions.json for full product details and localizations")
  end

  desc "Verify products exist in App Store Connect (requires API key)"
  lane :verify_iap_live do
    require 'json'
    require 'spaceship'

    # Check for API key environment variables
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

    unless key_id && issuer_id && key_path
      UI.user_error!(
        "API key environment variables not set!\n\n" +
        "Set these environment variables:\n" +
        "  export APP_STORE_CONNECT_API_KEY_ID=YOUR_KEY_ID\n" +
        "  export APP_STORE_CONNECT_ISSUER_ID=YOUR_ISSUER_ID\n" +
        "  export APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey_XXXXX.p8\n\n" +
        "Get these from App Store Connect → Users and Access → Integrations → Keys"
      )
    end

    # Connect to App Store Connect
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    # Load local config
    subscriptions_path = File.join(Dir.pwd, "subscriptions.json")
    config = JSON.parse(File.read(subscriptions_path))

    expected_products = []
    config["subscriptions"]&.each { |s| expected_products << s["product_id"] }
    config["non_consumables"]&.each { |nc| expected_products << nc["product_id"] }
    config["consumables"]&.each { |c| expected_products << c["product_id"] }

    UI.header("Checking App Store Connect for #{expected_products.count} products...")

    # Get app
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))

    unless app
      UI.user_error!("App not found in App Store Connect!")
    end

    UI.success("Found app: #{app.name} (#{app.bundle_id})")

    require 'net/http'
    require 'uri'
    require 'jwt'
    require 'openssl'

    # Build JWT token for API requests
    private_key = OpenSSL::PKey::EC.new(File.read(key_path))
    token = JWT.encode(
      {
        iss: issuer_id,
        iat: Time.now.to_i,
        exp: Time.now.to_i + 20 * 60, # 20 minutes
        aud: "appstoreconnect-v1"
      },
      private_key,
      "ES256",
      { kid: key_id }
    )

    # Helper to make ASC API requests
    def asc_get(path, token)
      uri = URI("https://api.appstoreconnect.apple.com#{path}")
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{token}"
      req["Content-Type"] = "application/json"
      response = http.request(req)
      JSON.parse(response.body)
    end

    # Get in-app purchases (consumables and non-consumables) via app relationship
    iap_data = asc_get("/v1/apps/#{app.id}/inAppPurchasesV2?limit=100", token)
    iaps = iap_data["data"] || []
    iap_ids = iaps.map { |iap| iap.dig("attributes", "productId") }.compact

    # Get subscription groups
    sub_group_data = asc_get("/v1/apps/#{app.id}/subscriptionGroups?limit=100", token)
    subscription_groups = sub_group_data["data"] || []
    sub_ids = []
    subscription_groups.each do |group|
      group_id = group["id"]
      sub_data = asc_get("/v1/subscriptionGroups/#{group_id}/subscriptions?limit=100", token)
      subs = sub_data["data"] || []
      subs.each do |sub|
        pid = sub.dig("attributes", "productId")
        sub_ids << pid if pid
      end
    end

    all_asc_products = iap_ids + sub_ids

    UI.message("")
    UI.message("📡 Products in App Store Connect:")
    all_asc_products.each { |p| UI.message("  • #{p}") }

    # Compare
    missing_in_asc = expected_products - all_asc_products
    extra_in_asc = all_asc_products - expected_products
    matched = expected_products & all_asc_products

    UI.message("")

    if matched.any?
      UI.success("✅ Matched (#{matched.count}):")
      matched.each { |p| UI.success("  • #{p}") }
    end

    if missing_in_asc.any?
      UI.error("❌ Missing from App Store Connect (#{missing_in_asc.count}):")
      missing_in_asc.each { |p| UI.error("  • #{p}") }
    end

    if extra_in_asc.any?
      UI.important("⚠️  Extra in App Store Connect (not in local config):")
      extra_in_asc.each { |p| UI.important("  • #{p}") }
    end

    if missing_in_asc.empty?
      UI.message("")
      UI.success("🎉 All #{expected_products.count} products are configured in App Store Connect!")
    else
      UI.user_error!("#{missing_in_asc.count} product(s) missing from App Store Connect!")
    end
  end

end

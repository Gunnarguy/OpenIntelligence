default_platform(:ios)

def cached_asc_env(key)
  @cached_asc_env ||= {
    "APP_STORE_CONNECT_API_KEY_ID" => ENV["APP_STORE_CONNECT_API_KEY_ID"],
    "APP_STORE_CONNECT_ISSUER_ID" => ENV["APP_STORE_CONNECT_ISSUER_ID"],
    "APP_STORE_CONNECT_API_KEY_PATH" => ENV["APP_STORE_CONNECT_API_KEY_PATH"],
  }

  value = @cached_asc_env[key]
  raise KeyError, "Missing #{key}" if value.nil? || value.empty?

  value
end

def clear_asc_conflicting_env!
  %w[
    APP_STORE_CONNECT_API_KEY_ID
    APP_STORE_CONNECT_ISSUER_ID
    APP_STORE_CONNECT_API_KEY_PATH
    APP_STORE_CONNECT_API_KEY
  ].each do |key|
    ENV.delete(key)
  end
end

platform :ios do
  private_lane :asc_api_key do
    key = app_store_connect_api_key(
      key_id: cached_asc_env("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: cached_asc_env("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: cached_asc_env("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    clear_asc_conflicting_env!
    key
  end

  private_lane :release_submission_information do
    {
      export_compliance_uses_encryption: false,
      add_id_info_uses_idfa: false
    }
  end

  desc "Upload release metadata for the App Store version"
  lane :upload_release_metadata do |options|
    version = options[:version] || "3.6"

    deliver(
      api_key: asc_api_key,
      app_identifier: "Gunndamental.OpenIntelligence",
      app_version: version,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: "fastlane/metadata",
      precheck_include_in_app_purchases: false,
      submission_information: release_submission_information
    )
  end

  desc "Build and upload the current release build to App Store Connect"
  lane :upload_release_build do |options|
    version = options[:version] || "3.6"
    build_number = options[:build] || "37"
    output_name = "OpenIntelligence-#{version}-#{build_number}.ipa"

    build_app(
      project: "OpenIntelligence.xcodeproj",
      scheme: "OpenIntelligence",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: output_name,
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: "Gunndamental.OpenIntelligence",
      ipa: File.join("build", output_name),
      skip_waiting_for_build_processing: false,
      changelog: File.read("fastlane/metadata/en-US/release_notes.txt")
    )
  end

  desc "Submit the current App Store version for review using an existing processed build"
  lane :submit_release do |options|
    version = options[:version] || "3.6"
    build_number = options[:build] || "37"

    deliver(
      api_key: asc_api_key,
      app_identifier: "Gunndamental.OpenIntelligence",
      app_version: version,
      build_number: build_number,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: "fastlane/metadata",
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: release_submission_information
    )
  end

  desc "Push metadata, upload build, and submit version for review"
  lane :release_to_review do |options|
    version = options[:version] || "3.6"
    build_number = options[:build] || "37"

    upload_release_metadata(version: version)
    upload_release_build(version: version, build: build_number)
    submit_release(version: version, build: build_number)
  end
end

# Fastfile for OpenIntelligence
# More documentation: https://docs.fastlane.tools

default_platform(:ios)

APP_IDENTIFIER = "Gunndamental.OpenIntelligence".freeze
PROJECT_PATH = "OpenIntelligence.xcodeproj".freeze
SCHEME = "OpenIntelligence".freeze
TEAM_ID = "Z3E334EXZD".freeze
ASC_KEY_ID = "JT97AQ3U4U".freeze
ASC_ISSUER_ID = "843e4ca0-4a91-49c5-93d1-c4e336d7c43b".freeze
ASC_KEY_PATH = File.expand_path("~/AuthKey_JT97AQ3U4U.p8").freeze

# Old fastlane versions treat APP_STORE_CONNECT_API_KEY_PATH as a second
# auth source and conflict with the explicit api_key we pass in lanes below.
ENV.delete("APP_STORE_CONNECT_API_KEY_PATH")

platform :ios do

  private_lane :app_review_information_payload do
    notes_path = File.join(__dir__, "review_notes.txt")
    {
      notes: File.read(notes_path).strip,
    }
  end

  # --- Shared API key config ---
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      in_house: false
    )
  end

  desc "Build the app for App Store submission"
  lane :build do
    build_app(
      scheme: SCHEME,
      project: PROJECT_PATH,
      export_method: "app-store",
      output_directory: "./build",
      output_name: "OpenIntelligence.ipa",
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID
      }
    )
  end

  desc "Submit to App Store Connect for review"
  lane :release do
    api_key = asc_api_key
    build
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end

  desc "Build, upload, and submit the current App Store version for review"
  lane :submit_review do
    api_key = asc_api_key
    build
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_screenshots: true,
      force: true,
      reject_if_possible: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      app_review_information: app_review_information_payload,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      }
    )
  end

  desc "Submit the current App Store version for review using the latest uploaded build"
  lane :submit_review_existing_build do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      reject_if_possible: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      app_review_information: app_review_information_payload,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      }
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    build_app(
      scheme: SCHEME,
      project: PROJECT_PATH,
      export_method: "app-store"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Increment build number"
  lane :bump do
    increment_build_number(xcodeproj: PROJECT_PATH)
  end

  desc "Push metadata to a draft App Store version (requires new version in ASC)"
  lane :metadata do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Update live App Store listing (description, keywords, promo text)"
  lane :metadata_live do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      edit_live: true,
      precheck_include_in_app_purchases: false,
      version_check_wait_retry_limit: 1
    )
  end

  desc "Validate app metadata and screenshots"
  lane :validate do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      verify_only: true,
      skip_screenshots: true,
      skip_binary_upload: true
    )
  end

  desc "Verify StoreKit products match subscription config"
  lane :verify_iap do
    require 'json'

    # Load subscription config
    subscriptions_path = File.join(__dir__, "subscriptions.json")
    unless File.exist?(subscriptions_path)
      UI.user_error!("subscriptions.json not found in fastlane directory")
    end

    config = JSON.parse(File.read(subscriptions_path))

    # Expected products from config
    expected_products = []

    config["subscriptions"]&.each do |sub|
      expected_products << sub["product_id"]
    end

    config["non_consumables"]&.each do |nc|
      expected_products << nc["product_id"]
    end

    config["consumables"]&.each do |c|
      expected_products << c["product_id"]
    end

    # Load StoreKit config
    storekit_path = File.expand_path("../OpenIntelligence/Resources/StoreKit/StoreKitConfiguration.storekit", __dir__)
    unless File.exist?(storekit_path)
      UI.user_error!("StoreKitConfiguration.storekit not found")
    end

    storekit = JSON.parse(File.read(storekit_path))
    storekit_products = storekit["products"].map { |p| p["id"] }

    # Compare
    missing_in_storekit = expected_products - storekit_products
    extra_in_storekit = storekit_products - expected_products

    if missing_in_storekit.any?
      UI.error("Products in subscriptions.json but NOT in StoreKitConfiguration.storekit:")
      missing_in_storekit.each { |p| UI.error("  - #{p}") }
    end

    if extra_in_storekit.any?
      UI.important("Products in StoreKitConfiguration.storekit but NOT in subscriptions.json:")
      extra_in_storekit.each { |p| UI.important("  - #{p}") }
    end

    if missing_in_storekit.empty? && extra_in_storekit.empty?
      UI.success("✅ All #{expected_products.count} products match between subscriptions.json and StoreKitConfiguration.storekit")

      # Print summary
      UI.message("")
      UI.message("📦 Product Summary:")
      config["subscriptions"]&.each do |sub|
        UI.message("  [SUB] #{sub['product_id']}: $#{sub['pricing']['USD']}/#{sub['duration']}")
      end
      config["non_consumables"]&.each do |nc|
        UI.message("  [IAP] #{nc['product_id']}: $#{nc['pricing']['USD']} (one-time)")
      end
      config["consumables"]&.each do |c|
        UI.message("  [CON] #{c['product_id']}: $#{c['pricing']['USD']} (consumable)")
      end
    else
      UI.user_error!("Product mismatch detected!")
    end
  end

  desc "Print App Store Connect setup checklist for subscriptions"
  lane :iap_checklist do
    require 'json'

    subscriptions_path = File.join(__dir__, "subscriptions.json")
    config = JSON.parse(File.read(subscriptions_path))

    UI.header("App Store Connect In-App Purchase Setup Checklist")
    UI.message("")

    config["app_store_connect_setup_checklist"]&.each do |step|
      UI.message("  #{step}")
    end

    UI.message("")
    UI.success("See fastlane/subscriptions.json for full product details and localizations")
  end

  desc "Verify products exist in App Store Connect"
  lane :verify_iap_live do
    require 'json'
    require 'spaceship'
    require 'net/http'
    require 'uri'
    require 'jwt'
    require 'openssl'

    api_key = asc_api_key

    subscriptions_path = File.join(__dir__, "subscriptions.json")
    config = JSON.parse(File.read(subscriptions_path))

    expected_products = []
    config["subscriptions"]&.each { |s| expected_products << s["product_id"] }
    config["non_consumables"]&.each { |nc| expected_products << nc["product_id"] }
    config["consumables"]&.each { |c| expected_products << c["product_id"] }

    UI.header("Checking App Store Connect for #{expected_products.count} products...")

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    unless app
      UI.user_error!("App not found in App Store Connect!")
    end
    UI.success("Found app: #{app.name} (#{app.bundle_id})")

    # Build JWT for direct API requests
    private_key = OpenSSL::PKey::EC.new(File.read(ASC_KEY_PATH))
    token = JWT.encode(
      {
        iss: ASC_ISSUER_ID,
        iat: Time.now.to_i,
        exp: Time.now.to_i + 20 * 60,
        aud: "appstoreconnect-v1"
      },
      private_key,
      "ES256",
      { kid: ASC_KEY_ID }
    )

    asc_get = lambda do |path|
      uri = URI("https://api.appstoreconnect.apple.com#{path}")
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{token}"
      req["Content-Type"] = "application/json"
      response = http.request(req)
      JSON.parse(response.body)
    end

    iap_data = asc_get.call("/v1/apps/#{app.id}/inAppPurchasesV2?limit=100")
    iaps = iap_data["data"] || []
    iap_ids = iaps.map { |iap| iap.dig("attributes", "productId") }.compact

    sub_group_data = asc_get.call("/v1/apps/#{app.id}/subscriptionGroups?limit=100")
    subscription_groups = sub_group_data["data"] || []
    sub_ids = []
    subscription_groups.each do |group|
      sub_data = asc_get.call("/v1/subscriptionGroups/#{group['id']}/subscriptions?limit=100")
      subs = sub_data["data"] || []
      subs.each do |sub|
        pid = sub.dig("attributes", "productId")
        sub_ids << pid if pid
      end
    end

    all_asc_products = iap_ids + sub_ids

    UI.message("")
    UI.message("Products in App Store Connect:")
    all_asc_products.each { |p| UI.message("  #{p}") }

    missing_in_asc = expected_products - all_asc_products
    extra_in_asc = all_asc_products - expected_products
    matched = expected_products & all_asc_products

    UI.message("")

    if matched.any?
      UI.success("Matched (#{matched.count}):")
      matched.each { |p| UI.success("  #{p}") }
    end

    if missing_in_asc.any?
      UI.error("Missing from App Store Connect (#{missing_in_asc.count}):")
      missing_in_asc.each { |p| UI.error("  #{p}") }
    end

    if extra_in_asc.any?
      UI.important("Extra in App Store Connect (not in local config):")
      extra_in_asc.each { |p| UI.important("  #{p}") }
    end

    if missing_in_asc.empty?
      UI.message("")
      UI.success("All #{expected_products.count} products are configured in App Store Connect!")
    else
      UI.user_error!("#{missing_in_asc.count} product(s) missing from App Store Connect!")
    end
  end

end

{
  "identifier": "com.openintelligence.storekit",
  "description": "StoreKit configuration for local testing of OpenIntelligence monetization tiers.",
  "version": 1,
  "defaultLocale": "en_US",
  "products": [
    {
      "id": "pro_monthly",
      "type": "auto-renewable-subscription",
      "referenceName": "Pro Monthly",
      "familySharable": false,
      "price": {
        "currencyCode": "USD",
        "value": 5.99
      },
      "subscription": {
        "groupID": "com.openintelligence.subscriptions",
        "duration": "P1M",
        "localizations": [
          {
            "locale": "en_US",
            "name": "Pro Monthly",
            "description": "Unlimited documents, 5 libraries, and premium retrieval controls."
          },
          {
            "locale": "en_GB",
            "name": "Pro Monthly",
            "description": "Unlimited documents, 5 libraries, and premium retrieval controls."
          },
          {
            "locale": "de_DE",
